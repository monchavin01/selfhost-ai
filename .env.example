# Copy to .env (make init) and fill in. .env is gitignored — never commit it.
# Used on your Mac only (make vast-*, make bench). The rented box gets its env from the Vast template
# "thaidub-gpu" (LITELLM_MASTER_KEY, TS_AUTHKEY, HF_TOKEN), never from this file.

# ===== SECRETS (real values only in .env and the Vast template) =====
# Bearer key ThaiDub sends to LiteLLM; same value as in the template. Generate: openssl rand -hex 24
LITELLM_MASTER_KEY=change-me

# ===== RENTAL (make vast-*) =====
# Hash of your private template (Vast console > Templates > thaidub-gpu)
VAST_TEMPLATE_HASH=
# Countries to search offers in (Vast geolocation codes, comma separated)
VAST_GEO=TW

# ===== CLIENT / BENCH =====
# LiteLLM through Tailscale (MagicDNS name of the box) — what ThaiDub and make bench use
LITELLM_URL=http://gpu-vast:4000

# ===== SERVER (only if you also add them to the template env; these are the defaults) =====
# Voice served for voice="default"
DEFAULT_VOICE=m_young_01
# 1 = also serve hunyuan-mt-7b via vLLM (24 GB card)
ENABLE_HUNYUAN=0
# F5 dynamic batching: max lines per GPU call, and how long to wait to fill a batch
F5_BATCH_MAX=8
F5_BATCH_WAIT_MS=15
# Seed used when the client sends none, so a line always sounds the same
F5_DEFAULT_SEED=0
