# Copy to .env (make init) and fill in. .env is gitignored — never commit it.
# Used by the Makefile on your Mac (make vast-*, make run, make bench) and by `make run` as the container env.
# On Vast the secrets are NOT read from this file: store them once as encrypted Vast account env vars
#   vastai create env-var LITELLM_MASTER_KEY <key>      (and HF_TOKEN / CLAUDE_CODE_OAUTH_TOKEN if used)

# ===== SECRETS (keep the real values only in .env and Vast account env vars) =====
# Bearer key ThaiDub sends to LiteLLM. Generate: openssl rand -hex 24
LITELLM_MASTER_KEY=change-me
# Only if a model in models.yaml becomes gated; all current ones are public.
HF_TOKEN=
# Claude Code on the rented box: one of these (claude setup-token makes the OAuth token on your Mac).
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# ===== RENTAL (make vast-*) =====
# Image you pushed with `make build push`; -hunyuan is appended automatically when ENABLE_HUNYUAN=1.
IMAGE=ghcr.io/<your-github-user>/thaidub-gpu-server:dev
# 1 = also serve hunyuan-mt-7b (24 GB card; uses the -hunyuan image tag and CUDA >= 12.9 offers)
ENABLE_HUNYUAN=1

# ===== SERVER =====
# Voice served for voice="default" (a voice_id from voices/)
DEFAULT_VOICE=m_young_01
# F5 dynamic batching: max lines per GPU call, and how long to wait to fill a batch
F5_BATCH_MAX=8
F5_BATCH_WAIT_MS=15
# Seed used when the client sends none, so a line always sounds the same
F5_DEFAULT_SEED=0
# Model cache. On a provider volume use /workspace/hf so a recreated rental skips the download.
HF_HOME=/data/hf
# Voice bank on the box (uploaded by make vast-voices; never in git or the image)
VOICES_DIR=/data/voices
