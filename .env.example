# Copy to .env and fill in. Never commit .env.
# On Vast, secrets are NOT read from this file: set them once as Vast account env vars (see README).
# ===== REQUIRED =====
# Bearer key ThaiDub sends (generate: openssl rand -hex 24)
LITELLM_MASTER_KEY=sk-change-this-to-a-long-random-string

# ===== OPTIONAL =====
# Only needed if a model in models.yaml becomes gated; all current ones are public.
HF_TOKEN=
# Voice served for voice="default" (a voice_id from voices/)
DEFAULT_VOICE=m_young_01
# 1 = also serve hunyuan-mt-7b (24 GB card; uses the -hunyuan image tag and CUDA >= 12.9 offers)
ENABLE_HUNYUAN=1
# F5 dynamic batching: max lines per GPU call, and how long to wait to fill a batch
F5_BATCH_MAX=8
F5_BATCH_WAIT_MS=15
# Seed used when the client sends none, so every server voices a line the same way
F5_DEFAULT_SEED=0
# Model cache. On a provider volume use /workspace/hf so a recreated rental skips the download.
HF_HOME=/data/hf
